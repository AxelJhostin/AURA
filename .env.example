# Server-only secret. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=replace_with_your_project_key

# Optional. The current default routes to GPT-5.6 Sol.
OPENAI_MODEL=gpt-5.6

# Optional persistent analytics. Keep both values server-only.
# Without them, AURA keeps an anonymous local event log and CSV export.
SUPABASE_URL=https://pnxnjcngmzcgbyslogcc.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_server_secret_key

# Optional canonical URL for local or non-Vercel production environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
